library(sda)
collage_photo$speed <- as.factor(collage_photo$speed)
collage_photo$person <- as.factor(collage_photo$person)
collage_photo$year <- as.factor(collage_photo$year)
photo_model <- lm(collage_photo)
summary(photo_model)
#b. Extend the previous linear model to test whether people improve as they assess more arrays
#(i.e. do they get better at recognising the people they know the more tries they have)?
#Is there a big improvement from the first trial to the sixth?
#Hint: The function rep might be useful here in order to generate the predictor variable.
collage_photo_trial <- collage_photo
View(collage_photo_trial)
View(collage_photo)
collage_photo_trial$trial <- rep(1:6, 24)
glm(collage_photo)
glm_photo_model <- glm(y~speed, data=collage_photo, family=quasipoisson(link = "log"))
summary(glm_photo_model)
#e. Refit your first model (from part a) using glm and assume the data are Poisson distributed with
#log link. What is the best estimate of how many more people (as a %) are recognised when given 5 seconds
#versus 3 seconds?
glm_photo_model <- glm(y~speed, data=collage_photo, family=poisson(link = "log"))
exp(summary(glm_photo_model)$coef["speed5","Estimate"])
summary(glm_photo_model)
collage_photo$speed <- as.numeric(collage_photo$speed)
glm_photo_model <- glm(y~speed, data=collage_photo, family=poisson(link = "log"))
summary(glm_photo_model)
