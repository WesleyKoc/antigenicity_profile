list=c()
y<-rank(rats$y)
AorBdiet <- data.frame(cbind(Adiet$y, Bdiet$y))
AorBdiet$Diff <- AorBdiet$X1 - AorBdiet$X2
colnames(AorBdiet) <- c('A', 'B', 'Diff')
AorBdiet <- AorBdiet[order(as.vector(AorBdiet[[3]])), ]
AorBdiet
